{
  "name": "copper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "licences": "node scripts/check-licences.mjs",
    "forbidden": "node scripts/forbidden-sources.mjs && pnpm run check:bytes",
    "check:rig": "tsx scripts/rig-ratchet.mjs",
    "check:catalog": "node catalog/scripts/validate.mjs",
    "check:theme": "node scripts/check-hex-literals.mjs",
    "check:ledger": "node scripts/check-ledger.mjs",
    "check:bytes": "node scripts/check-bytes.mjs",
    "check:setinterval": "node scripts/check-setinterval.mjs"
  },
  "devDependencies": {
    "@copper/schema": "workspace:*",
    "@eslint/js": "^9.21.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "eslint": "^9.21.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest-axe": "^11.0.0",
    "js-yaml": "^5.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
